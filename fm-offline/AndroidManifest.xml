<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="pl.radiokia.fm"
    android:versionCode="10" android:versionName="0.7.2">
    <uses-sdk android:minSdkVersion="27" android:targetSdkVersion="34"/>
    <queries>
        <package android:name="com.tw.service.xt"/>
        <package android:name="com.tw.radio"/>
        <package android:name="pl.radiokia.preview"/>
    </queries>
    <application android:label="@string/app_name" android:allowBackup="false" android:theme="@android:style/Theme.Material.NoActionBar">
        <provider android:name=".PresetData" android:authorities="pl.radiokia.fm.presets" android:exported="true"/>
        <activity android:name=".Radio" android:exported="true" android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <service android:name=".FactoryFmAccess" android:exported="true"
            android:label="@string/factory_fm_access_name" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService"/></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/factory_fm_access"/>
        </service>
    </application>
</manifest>
